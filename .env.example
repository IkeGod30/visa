# Firebase project config (Project settings -> General -> Your apps -> SDK setup and config).
# Copy this file to .env.local, fill in your project's values, and restart the dev server.
# .env.local is gitignored — never commit real keys.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# Payments (see README → Payments).
# Paystack PUBLIC key only (pk_test_… or pk_live_…). Never put the secret key (sk_…) here.
VITE_PAYSTACK_PUBLIC_KEY=
# Account shown to clients for direct bank transfer.
VITE_BANK_NAME=
VITE_BANK_ACCOUNT_NUMBER=
VITE_BANK_ACCOUNT_NAME=
